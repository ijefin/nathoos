---
import TornEdge from './TornEdge.astro';
import { faq } from '../data/site';
---

<section class="faq grain torn" id="duvidas" aria-labelledby="duvidas-titulo">
  <TornEdge seed={41} />
  <div class="frame">
    <h2 id="duvidas-titulo" class="faq-title" data-split>Dúvidas frequentes</h2>
    <div class="faq-list">
      {
        faq.map((item) => (
          <details class="faq-item">
            <summary>
              <span>{item.q}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 9 7 7 7-7" fill="none" stroke="currentColor" stroke-width="2" /></svg>
            </summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq { background: var(--color-paper); color: var(--color-ink); padding-block: clamp(96px, 10vw, 180px); }
  .faq > :global(.torn-edge) { color: var(--color-paper); }
  .faq-title { font-size: var(--step-title); line-height: 0.95; letter-spacing: -0.02em; max-width: 14ch; }
  .faq-list {
    margin-top: 80px;
    margin-left: calc(4 * (var(--col) + var(--gutter)));
    display: grid;
    gap: 12px;
  }
  .faq-item { padding: 12px 24px; margin-inline: -24px; transition: background-color var(--t-ui) ease; }
  .faq-item[open] { background: var(--color-paper-2); padding-bottom: 24px; }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    min-height: 44px;
    font-size: var(--step-lead);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary svg { flex: none; width: 24px; height: 24px; transition: transform var(--t-ui) var(--ease-out); }
  .faq-item[open] summary svg { transform: rotate(180deg); }
  .faq-item p { max-width: 48ch; margin-top: 12px; }

  @media (max-width: 820px) {
    .faq-list { margin-left: 0; margin-top: 48px; gap: 4px; }
    .faq-item { margin-inline: calc(-1 * var(--margin)); padding-inline: var(--margin); }

  }
</style>

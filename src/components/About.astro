---
import { Picture } from 'astro:assets';
import InkSplat from './InkSplat.astro';
import { portraits } from '../data/site';
---

<section class="about on-ink grain" id="sobre" aria-labelledby="sobre-titulo">
  <div class="about-pin">
    <h2 id="sobre-titulo" class="display about-title">Quem<br />tatua</h2>
  </div>

  <ul class="about-list" role="list">
    {
      portraits.map((p, i) => (
        <li class:list={['portrait', i % 2 ? 'portrait--right' : 'portrait--left']}>
          <figure class="portrait-figure" data-drift>
            <Picture
              src={p.image}
              formats={['avif', 'webp']}
              widths={[360, 540, 720]}
              sizes="(max-width: 820px) 86vw, 28vw"
              alt={p.alt}
              loading="lazy"
            />
          </figure>
          <div class="portrait-card-wrap" data-splat>
            {/* Respingos ficam atrás do papel: só aparece o que escapa pelas bordas. */}
            <InkSplat seed={i * 3 + 1} color={i % 2 ? 'accent' : 'stencil'} class="splat-a" />
            <InkSplat seed={i * 3 + 2} color={i % 2 ? 'stencil' : 'accent'} class="splat-b" />
            <div class="portrait-card">
              <p class="portrait-name">{p.name}</p>
              <p class="portrait-role">{p.role}</p>
              <p class="portrait-text" data-fill-card>{p.text}</p>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .about { position: relative; color: var(--fg); }
  .about-pin {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    place-items: center;
    z-index: 2;
    pointer-events: none;
  }
  .about-title { font-size: var(--step-display); text-align: center; line-height: 0.85; }

  .about-list {
    position: relative;
    z-index: 1;
    margin: -60svh 0 0;
    padding: 0 var(--margin) 12svh;
    list-style: none;
  }
  .portrait { width: clamp(260px, 24vw, 400px); }
  .portrait--right { margin-left: auto; }
  /* O próximo retrato começa enquanto o anterior ainda está na tela, do outro lado. */
  .portrait + .portrait { margin-top: -12vw; }

  .portrait-figure { margin: 0; aspect-ratio: 4 / 5; overflow: clip; }
  .portrait-figure :global(img) { width: 100%; height: 108%; object-fit: cover; }

  .portrait-card-wrap { position: relative; margin-top: -48px; isolation: isolate; }

  .portrait-card {
    position: relative;
    z-index: 1;
    padding: 36px 32px 40px;
    background: #f4f4f1;
    color: var(--color-ink);
    clip-path: polygon(0 2.5%, 8% 0, 17% 1.6%, 29% 0, 41% 2%, 53% 0.4%, 64% 2.2%, 76% 0, 88% 1.5%, 100% 0.3%, 100% 97.6%, 91% 100%, 80% 98.2%, 68% 100%, 57% 98.4%, 45% 100%, 33% 98%, 21% 100%, 10% 98.4%, 0 99.6%);
  }
  .portrait--left .portrait-card { transform: rotate(-1deg); }
  .portrait--right .portrait-card { transform: rotate(1deg); }

  .portrait-name { font-size: var(--step-lead); font-weight: 800; line-height: 1.15; }
  .portrait-role { font-size: var(--step-small); font-weight: 600; color: var(--color-stencil); margin: 4px 0 14px; }
  .portrait-text { font-size: clamp(1.125rem, 1rem + 0.35vw, 1.3125rem); line-height: 1.5; max-width: 34ch; }

  .portrait-card-wrap :global(.ink-splat) { z-index: 0; }
  .portrait-card-wrap :global(.splat-a) { width: 132px; height: 132px; top: -44px; right: -46px; }
  .portrait-card-wrap :global(.splat-b) { width: 86px; height: 86px; bottom: -34px; left: -30px; }
  .portrait--right .portrait-card-wrap :global(.splat-a) { right: auto; left: -46px; }
  .portrait--right .portrait-card-wrap :global(.splat-b) { left: auto; right: -30px; }

  @media (max-width: 820px) {
    .about-pin { position: relative; height: auto; place-items: start; padding: 96px var(--margin) 0; }
    .about-title { font-size: 13vw; text-align: left; }
    .about-list { margin-top: 40px; padding-bottom: 96px; }
    .portrait { width: 86%; }
    .portrait + .portrait { margin-top: 72px; }
    .portrait-card { padding: 28px 22px 32px; }
    .portrait-card-wrap :global(.splat-a) { width: 96px; height: 96px; top: -30px; right: -22px; }
    .portrait--right .portrait-card-wrap :global(.splat-a) { left: -22px; }
    .portrait-card-wrap :global(.splat-b) { width: 64px; height: 64px; bottom: -24px; left: -16px; }
    .portrait--right .portrait-card-wrap :global(.splat-b) { right: -16px; }
  }
</style>

---
import { Picture } from 'astro:assets';
import { portraits } from '../data/site';
---

<section class="about on-ink grain" id="sobre" aria-labelledby="sobre-titulo">
  <div class="about-pin">
    <h2 id="sobre-titulo" class="display about-title">Quem<br />tatua</h2>
  </div>

  <ul class="about-list" role="list">
    {
      portraits.map((p, i) => (
        <li class:list={['portrait', i % 2 ? 'portrait--right' : 'portrait--left']}>
          <figure class="portrait-figure" data-drift>
            <Picture
              src={p.image}
              formats={['avif', 'webp']}
              widths={[360, 540, 720]}
              sizes="(max-width: 820px) 72vw, 26vw"
              alt={p.alt}
              loading="lazy"
            />
          </figure>
          <p class="portrait-name">{p.name}</p>
          <p class="portrait-role">{p.role}</p>
          <p class="portrait-text">{p.text}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .about { position: relative; color: var(--color-paper); }
  .about-pin {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    place-items: center;
    z-index: 2;
    pointer-events: none;
  }
  .about-title { font-size: var(--step-display); text-align: center; line-height: 0.85; }

  .about-list {
    position: relative;
    z-index: 1;
    margin: -60svh 0 0;
    padding: 0 var(--margin) 12svh;
    list-style: none;
  }
  .portrait { width: clamp(240px, 24vw, 420px); }
  /* O próximo retrato começa enquanto o anterior ainda está na tela, do outro lado. */
  .portrait + .portrait { margin-top: -10vw; }
  .portrait--right { margin-left: auto; }
  .portrait-figure { margin: 0 0 16px; aspect-ratio: 4 / 5; overflow: clip; }
  .portrait-figure :global(img) { width: 100%; height: 108%; object-fit: cover; }
  .portrait-name { font-weight: 700; }
  .portrait-role { font-size: var(--step-small); color: var(--color-wash-light); margin-bottom: 8px; }
  .portrait-text { max-width: 34ch; }

  @media (max-width: 820px) {
    .about-pin { position: relative; height: auto; place-items: start; padding: 96px var(--margin) 0; }
    .about-title { font-size: 13vw; text-align: left; }
    .about-list { margin-top: 32px; padding-bottom: 96px; }
    .portrait { width: 72%; }
    .portrait + .portrait { margin-top: 48px; }
  }
</style>

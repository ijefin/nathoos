---
import TornEdge from './TornEdge.astro';
import { asset } from '../lib/url';

/** "O que eu faço": cada palavra começa em traço de stencil e enche de tinta ao passar pelo meio da tela. */
const craft = [
  { word: 'Preto e cinza', text: 'Sombra, contraste e profundidade construídos só com preto e diluições.' },
  { word: 'Realismo animal', text: 'Pelo, textura e olhar de lobos, tigres e o bicho que tiver história pra você.' },
  { word: 'Rostos', text: 'Retratos que guardam a expressão de quem importa.' },
  { word: 'Coberturas', text: 'Uma tatuagem antiga vira base para um projeto novo, avaliado pessoalmente.' },
  { word: 'Freehand', text: 'Desenho direto na pele, pensado em cima da anatomia de cada corpo.' },
];
---

<section class="specialties on-ink grain torn" id="apresentacao" aria-labelledby="apresentacao-titulo">
  <TornEdge seed={3} />
  <div class="frame grid-12 intro">
    <h2 id="apresentacao-titulo" class="head intro-title" data-split>O que eu faço</h2>
    <p class="intro-statement lead" data-fill>
      Faço da tatuagem delicada até a mais complexa. Sou especializado em preto e cinza, principalmente animais, rostos e
      coberturas, com muita arte no freehand.
    </p>
    <figure class="intro-media">
      <video muted loop playsinline preload="none" poster={asset('media/tinta.jpg')} width="478" height="850" aria-label="Gota de tinta preta caindo no batoque, em câmera lenta" data-inview-play>
        <source src={asset('media/tinta.webm')} type="video/webm" />
        <source src={asset('media/tinta.mp4')} type="video/mp4" />
      </video>
    </figure>
  </div>

  <ul class="frame craft" role="list">
    {
      craft.map((c) => (
        <li class="craft-row" data-craft>
          <p class="craft-word">
            <span class="stencil">{c.word}</span>
            <span class="craft-ink" aria-hidden="true">{c.word}</span>
          </p>
          <p class="craft-text">{c.text}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .specialties { color: var(--fg); padding-block: clamp(96px, 12vw, 200px); }
  .specialties > :global(.torn-edge) { color: var(--bg); }

  .intro { row-gap: 32px; align-items: end; }
  .intro-title { grid-column: 1 / 7; grid-row: 1; }
  .intro-statement { grid-column: 1 / 7; grid-row: 2; max-width: 32ch; }
  .intro-media { grid-column: 9 / 13; grid-row: 1 / 3; margin: 0; aspect-ratio: 4 / 5; overflow: clip; background: var(--bg-2); }
  .intro-media video { width: 100%; height: 100%; object-fit: cover; }

  .craft { margin: clamp(72px, 8vw, 140px) 0 0; list-style: none; display: grid; gap: clamp(28px, 3vw, 44px); }
  .craft-row { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: var(--gutter); align-items: center; }
  .craft-word {
    position: relative;
    width: max-content;
    max-width: 100%;
    font-weight: 800;
    font-stretch: 150%;
    text-transform: uppercase;
    font-size: clamp(2.25rem, 5.4vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
  }
  .craft-ink {
    position: absolute;
    inset: 0;
    color: var(--fg);
    -webkit-text-stroke: clamp(1.5px, 0.16vw, 2.5px) var(--fg);
    clip-path: inset(0 0 0 0);
  }
  :global(.js) .craft-ink { clip-path: inset(0 100% 0 0); }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .craft-ink { clip-path: inset(0 0 0 0); }
  }
  .craft-text { max-width: 36ch; }

  @media (max-width: 820px) {
    .intro-title,
    .intro-statement { grid-column: 1 / -1; grid-row: auto; }
    .intro-media { grid-column: 1 / -1; grid-row: auto; aspect-ratio: 16 / 10; }
    .craft-row { grid-template-columns: 1fr; row-gap: 8px; }
    .craft-word { width: auto; font-size: clamp(1.75rem, 9vw, 2.5rem); white-space: normal; }
  }
</style>

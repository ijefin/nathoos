---
import { getCollection, type CollectionEntry } from 'astro:content';
import TornEdge from './TornEdge.astro';
import Media from './JourneyMedia.astro';
import { etapasCobertura, rotulos } from '../data/jornadas';

interface Props {
  /** Na prévia aparecem os rascunhos e as molduras do que falta mandar. */
  preview?: boolean;
}
const { preview = false } = Astro.props;

type Projeto = CollectionEntry<'projetos'>['data'];
type Etapa = Projeto['etapas'][number];

const todos = (await getCollection('projetos', ({ data }) => preview || data.status === 'publicado')).map((e) => e.data);
const ordenar = (a: Projeto, b: Projeto) => a.ordem - b.ordem;
const zero = todos.filter((p) => p.jornada === 'zero').sort(ordenar);
const cobertura = todos.filter((p) => p.jornada === 'cobertura').sort(ordenar);
const feminino = cobertura.find((p) => p.perfil === 'feminino');
const masculino = cobertura.find((p) => p.perfil === 'masculino');

// No site público uma etapa só aparece com mídia real; na prévia aparece tudo.
const visivel = (e?: Etapa) => !!e && (preview || e.midia.length > 0);
const etapa = (p: Projeto | undefined, chave: string) => p?.etapas.find((e) => e.chave === chave);
const feedbackVisivel = (p?: Projeto) => !!p?.feedback && (p.feedback.autorizado || preview);
---

<section class="journeys grain torn" id="jornadas" aria-labelledby="jornadas-titulo">
  <TornEdge seed={7} />
  <div class="frame journeys-head">
    <h2 id="jornadas-titulo" class="head" data-split>Casos reais</h2>
    <p class="lead">Antes de qualquer pergunta, o que já foi feito: do primeiro contato ao resultado, em fotos e vídeos.</p>
  </div>

  <div class="frame journeys-tabs" role="tablist" aria-label="Jornadas">
    <button type="button" role="tab" id="aba-zero" aria-controls="painel-zero" aria-selected="true" data-tab>Do zero</button>
    <button type="button" role="tab" id="aba-cobertura" aria-controls="painel-cobertura" aria-selected="false" tabindex="-1" data-tab>Cobertura</button>
  </div>

  <div class="journeys-panel" role="tabpanel" id="painel-zero" aria-labelledby="aba-zero" data-panel>
    {
      zero.map((p) => (
        <article class="project">
          <header class="frame project-head">
            <h3 class="project-title">{p.titulo}</h3>
            <p class="project-meta">{p.local}{p.status === 'rascunho' && ' · rascunho'}</p>
            {p.resumo && <p class="project-sum">{p.resumo}</p>}
          </header>
          <ol class="strip" role="list" aria-label={`Etapas: ${p.titulo}`}>
            {p.etapas.filter(visivel).map((e) => (
              <li class="stage">
                <Media e={e} />
                <p class="stage-name">{rotulos[e.chave]}</p>
                {e.texto && <p class="stage-text">{e.texto}</p>}
              </li>
            ))}
          </ol>
        </article>
      ))
    }
  </div>

  <div class="journeys-panel" role="tabpanel" id="painel-cobertura" aria-labelledby="aba-cobertura" data-panel hidden>
    {
      feminino || masculino ? (
        <div class="pair-scroll">
          <table class="pair">
            <caption class="sr-only">Dois projetos de cobertura, etapa por etapa</caption>
            <thead>
              <tr>
                <th scope="col" class="pair-corner">Etapa</th>
                {etapasCobertura.map((k) => <th scope="col" class="stage-name">{rotulos[k]}</th>)}
              </tr>
            </thead>
            <tbody>
              {[feminino, masculino].filter(Boolean).map((p) => (
                <tr>
                  <th scope="row" class="pair-who">
                    <span class="project-title">{p!.perfil === 'feminino' ? 'Ela' : 'Ele'}</span>
                    <span class="project-meta">{p!.local}</span>
                  </th>
                  {etapasCobertura.map((k) => {
                    const e = etapa(p, k);
                    if (k === 'feedback' && feedbackVisivel(p))
                      return (
                        <td class="stage">
                          <blockquote class="feedback">
                            <p>{p!.feedback!.texto}</p>
                            <footer>{p!.feedback!.autor}</footer>
                          </blockquote>
                        </td>
                      );
                    return <td class="stage">{visivel(e) ? <><Media e={e!} />{e!.texto && <p class="stage-text">{e!.texto}</p>}</> : null}</td>;
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="frame journeys-empty">
          <p class="lead">
            Dois projetos reais de cobertura estão sendo documentados, da tatuagem antiga ao resultado cicatrizado. O antes e
            depois só entra aqui com autorização de cada cliente.
          </p>
          <a class="button" href="#orcamento">Avaliar minha cobertura</a>
        </div>
      )
    }
  </div>
</section>

<style>
  .journeys { background: var(--bg); color: var(--fg); padding-block: clamp(96px, 10vw, 180px); }
  .journeys > :global(.torn-edge) { color: var(--bg); }
  .journeys-head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 20px;
    align-items: end;
  }
  .journeys-head h2 { grid-column: 1 / 7; }
  .journeys-head p { grid-column: 7 / 12; max-width: 34ch; }

  .journeys-tabs { display: flex; gap: 8px; margin: 40px 0 48px; }
  .journeys-tabs [role='tab'] {
    min-height: 52px;
    padding: 0 22px;
    border: 0;
    background: var(--bg-2);
    color: var(--fg);
    font: inherit;
    font-size: var(--step-lead);
    font-weight: 700;
    cursor: pointer;
    transition: background-color var(--t-hover) ease, color var(--t-hover) ease;
  }
  .journeys-tabs [aria-selected='true'] { background: var(--fg); color: var(--bg); }

  .project + .project { margin-top: 80px; }
  .project-head { display: grid; gap: 6px; margin-bottom: 24px; }
  .project-title { font-size: var(--step-lead); font-weight: 800; }
  .project-meta { color: var(--muted); font-size: var(--step-small); font-weight: 600; }
  .project-sum { max-width: 52ch; }

  /* Faixa de etapas: rolagem nativa com encaixe; a margem da página vira o recuo. */
  .strip {
    display: flex;
    gap: var(--gutter);
    margin: 0;
    padding: 0 var(--margin) 12px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--margin);
    overscroll-behavior-x: contain;
  }
  .stage { flex: none; width: clamp(260px, 28vw, 420px); scroll-snap-align: start; }
  .stage-name { margin-top: 14px; font-weight: 800; font-stretch: 75%; text-transform: uppercase; font-size: clamp(1.75rem, 2.6vw, 2.5rem); line-height: 1; }
  .stage-text { margin-top: 8px; max-width: 34ch; }

  .pair-scroll { overflow-x: auto; padding: 0 var(--margin) 12px; overscroll-behavior-x: contain; }
  .pair { border-collapse: separate; border-spacing: var(--gutter) 28px; margin-inline: calc(-1 * var(--gutter)); }
  .pair th,
  .pair td { vertical-align: top; text-align: left; padding: 0; }
  .pair thead .stage-name { margin: 0; padding-bottom: 4px; min-width: clamp(220px, 20vw, 300px); }
  .pair-corner { color: var(--muted); font-size: var(--step-small); font-weight: 600; }
  .pair-who { display: grid; gap: 4px; min-width: 120px; }
  .pair .stage { width: clamp(220px, 20vw, 300px); }

  .feedback {
    margin: 0;
    padding: 28px 24px;
    background: #f4f4f1;
    color: var(--color-ink);
    font-size: var(--step-lead);
    line-height: 1.35;
  }
  .feedback footer { margin-top: 14px; font-size: var(--step-small); font-weight: 700; color: var(--color-stencil); }

  .journeys-empty { display: grid; gap: 24px; justify-items: start; max-width: 60ch; }

  @media (max-width: 820px) {
    .journeys-head h2,
    .journeys-head p { grid-column: 1 / -1; }
    .journeys-tabs [role='tab'] { flex: 1; font-size: var(--step-body); }
    .stage { width: 78vw; }
  }
</style>

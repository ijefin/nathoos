---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { asset } from '../lib/url';

type Etapa = CollectionEntry<'projetos'>['data']['etapas'][number];
interface Props {
  e: Etapa;
}
const { e } = Astro.props;
const m = e.midia[0];
---

{
  m?.imagem ? (
    <figure class="jm">
      <Picture src={m.imagem} formats={['avif', 'webp']} widths={[320, 480, 640]} sizes="(max-width: 820px) 78vw, 24vw" alt={m.alt} loading="lazy" />
    </figure>
  ) : m?.video ? (
    <figure class="jm">
      <video muted loop playsinline preload="none" poster={asset(`media/${m.video}.jpg`)} width="478" height="850" aria-label={m.alt} data-inview-play>
        <source src={asset(`media/${m.video}.webm`)} type="video/webm" />
        <source src={asset(`media/${m.video}.mp4`)} type="video/mp4" />
      </video>
    </figure>
  ) : (
    <div class="jm jm--pending" role="note">
      <p><strong>Falta:</strong> {e.pendente ?? 'foto ou vídeo desta etapa.'}</p>
    </div>
  )
}

<style>
  .jm { margin: 0; aspect-ratio: 4 / 5; overflow: clip; background: var(--bg-2); }
  .jm :global(img),
  .jm video { width: 100%; height: 100%; object-fit: cover; }
  /* Moldura de pendência: só aparece na prévia. */
  .jm--pending { display: grid; place-items: center; padding: 20px; outline: 2px dashed var(--line); outline-offset: -2px; } /* taste-skill-ignore: moldura interna da prévia */
  .jm--pending p { font-size: var(--step-small); max-width: 28ch; }
</style>

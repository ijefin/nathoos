---
import { Picture, getImage } from 'astro:assets';
import TornEdge from './TornEdge.astro';
import { works, styles } from '../data/site';

// Versão grande para o lightbox (os originais do WhatsApp têm no máximo ~600px).
const large = await Promise.all(works.map((w) => getImage({ src: w.image, format: 'webp', width: Math.min(w.image.width, 1200) })));
---

<section class="work on-ink grain torn" id="trabalhos" aria-labelledby="trabalhos-titulo">
  <TornEdge seed={19} />

  <div class="frame work-filters" role="group" aria-label="Filtrar por estilo">
    <button type="button" class="work-filter" aria-pressed="true" data-filter="*">Todos</button>
    {
      styles.map((style) => (
        <button type="button" class="work-filter" aria-pressed="false" data-filter={style}>
          {style === 'Cobertura' ? 'Coberturas' : style}
        </button>
      ))
    }
  </div>

  <div class="work-stage">
    <div class="work-hold" aria-hidden="true">
      <div class="work-frame" data-work-frame>
        {
          works.map((w, i) => (
            <Picture
              src={w.image}
              formats={['avif', 'webp']}
              widths={[320, 480, 640]}
              sizes="(max-width: 820px) 60vw, 31vw"
              alt=""
              loading="lazy"
              class:list={['work-shot', i === 0 && 'is-current']}
              data-shot={w.slug}
            />
          ))
        }
      </div>
      <p class="work-fact work-fact--left" data-fact="style">{works[0].style}</p>
      <p class="work-fact work-fact--right" data-fact="place">{works[0].place}</p>
    </div>

    <ol class="work-list" role="list">
      <li class="work-heading"><h2 id="trabalhos-titulo" class="condensed">Trabalhos</h2></li>
      {
        works.map((w, i) => (
          <li class="work-item" data-style={w.style} data-slug={w.slug}>
            <button
              type="button"
              class="work-name condensed"
              data-open-work={w.slug}
              data-cursor="ver"
              data-src={large[i].src}
              data-name={w.name}
              data-style-label={w.style}
              data-place={w.place}
              data-note={w.note ?? ''}
              data-alt={w.alt}
            >
              {w.name}
              <span class="sr-only">, {w.style}, {w.place}. Abrir foto.</span>
            </button>
          </li>
        ))
      }
      <li class="work-empty" hidden data-work-empty>
        <p class="lead">
          Antes e depois de coberturas só aparece aqui com autorização do cliente. Na avaliação presencial eu mostro os casos
          que posso mostrar.
        </p>
      </li>
    </ol>
  </div>

  <dialog class="lightbox on-ink" data-lightbox aria-labelledby="lightbox-titulo">
    <div class="lightbox-body">
      <button type="button" class="lightbox-zoom" data-zoom aria-label="Ampliar a foto para ver o traço">
        <img alt="" data-lightbox-img />
      </button>
      <div class="lightbox-info">
        <h3 id="lightbox-titulo" class="condensed lightbox-title" data-lightbox-title></h3>
        <p data-lightbox-meta></p>
        <p class="lightbox-note" data-lightbox-note></p>
        <a class="button" href="#orcamento" data-lightbox-cta>Quero algo assim</a>
      </div>
      <button type="button" class="lightbox-close link" data-close>Fechar</button>
    </div>
  </dialog>
</section>

<style>
  .work { --frame: min(31vw, 460px); padding-block: clamp(80px, 8vw, 140px) 0; }
  .work > :global(.torn-edge) { color: var(--color-ink); }

  .work-filters { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 28px; position: relative; z-index: 3; }
  .work-filter {
    font: inherit;
    font-size: var(--step-small);
    color: var(--color-wash-light);
    background: none;
    border: 0;
    padding: 8px 0;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.3em;
    transition: color var(--t-hover) ease, text-decoration-color var(--t-hover) ease;
  }
  .work-filter[aria-pressed='true'] { color: var(--color-paper); text-decoration-color: var(--color-accent); }
  @media (hover: hover) and (pointer: fine) { .work-filter:hover { color: var(--color-paper); } }

  .work-stage { position: relative; padding-bottom: 30svh; }

  .work-hold {
    position: sticky;
    top: calc(50svh - var(--frame) / 2);
    height: var(--frame);
    margin-bottom: calc(-1 * var(--frame));
    display: grid;
    place-items: center;
    z-index: 0;
  }
  .work-frame { position: relative; width: var(--frame); height: var(--frame); overflow: clip; background: var(--color-ink-2); }
  .work-frame :global(picture),
  .work-frame :global(img),
  .work-frame :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .work-frame :global(.work-shot) { opacity: 0; transition: opacity 200ms ease; }
  .work-frame :global(.work-shot.is-current) { opacity: 1; }
  .work-frame::after { content: ''; position: absolute; inset: 0; background: rgb(0 0 0 / 0.3); z-index: 2; }
  .work-frame.has-gl :global(.work-shot) { visibility: hidden; }

  .work-fact {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: var(--step-small);
    color: var(--color-paper);
    width: 12vw;
  }
  /* Nas margens, fora do alcance dos nomes que passam pelo meio. */
  .work-fact--left { left: var(--margin); }
  .work-fact--right { right: var(--margin); text-align: right; }

  .work-list { position: relative; z-index: 1; margin: 0; padding: 30svh 0 0; list-style: none; text-align: center; }
  .work-heading h2 { font-size: clamp(88px, 14vw, 210px); color: var(--color-wash); margin-bottom: 0.08em; }

  .work-name {
    font: inherit;
    font-weight: 800;
    font-stretch: 75%;
    font-size: clamp(88px, 14vw, 210px);
    line-height: 0.85;
    color: var(--color-paper);
    opacity: 0.4;
    background: none;
    border: 0;
    padding: 0.02em 0;
    cursor: pointer;
    transition: opacity var(--t-ui) ease, color var(--t-hover) ease;
  }
  .work-item.is-current .work-name { opacity: 1; }
  @media (hover: hover) and (pointer: fine) {
    .work-name:hover { opacity: 1; color: var(--color-stencil-light); }
  }
  .work-empty { max-width: 34ch; margin: 10vh auto 0; color: var(--color-paper); }

  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100svh;
    max-height: 100svh;
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--color-paper);
    background: transparent;
  }
  /* taste-skill-ignore: blur pedido no briefing, só no fundo do diálogo */
  .lightbox::backdrop { background: rgb(0 0 0 / 0.86); backdrop-filter: blur(8px); }
  .lightbox-body {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--gutter);
    height: 100%;
    padding: var(--margin);
    align-items: center;
  }
  .lightbox-zoom { position: relative; height: calc(100svh - 2 * var(--margin)); padding: 0; border: 0; background: none; overflow: hidden; cursor: zoom-in; }
  .lightbox-zoom img { width: 100%; height: 100%; object-fit: contain; transition: transform 400ms var(--ease-out); }
  .lightbox-zoom.is-zoomed { cursor: zoom-out; }
  .lightbox-zoom.is-zoomed img { transform: scale(2.2); }
  .lightbox-info { display: grid; gap: 18px; align-content: center; justify-items: start; max-width: 36ch; }
  .lightbox-title { font-size: var(--step-display); }
  .lightbox-note { font-size: var(--step-lead); line-height: 1.35; }
  .lightbox-close { position: absolute; top: var(--margin); right: var(--margin); font: inherit; font-size: var(--step-small); color: var(--color-paper); background: none; border: 0; cursor: pointer; padding: 8px; }

  @media (max-width: 820px) {
    .work { --frame: 60vw; }
    .work-hold { display: block; }
    .work-frame { margin-inline: auto; }
    /* No celular os nomes ocupam a largura toda; estilo e local ficam no lightbox. */
    .work-fact { display: none; }
    .work-heading h2,
    .work-name { font-size: 15vw; line-height: 1; }
    .lightbox-body { grid-template-columns: 1fr; align-content: start; overflow-y: auto; padding-top: 64px; }
    .lightbox-zoom { height: 60svh; }
  }
</style>

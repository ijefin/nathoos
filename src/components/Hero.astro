---
import { Picture } from 'astro:assets';
import ThemeToggle from './ThemeToggle.astro';
import InkSplat from './InkSplat.astro';
import nathan from '../assets/media/hero/nathan.jpg';
import logo from '../assets/media/brand/logo.png';

const nav = [
  { href: '#jornadas', label: 'Projetos' },
  { href: '#trabalhos', label: 'Trabalhos' },
  { href: '#processo', label: 'Processo' },
  { href: '#sobre', label: 'Sobre' },
  { href: '#duvidas', label: 'Dúvidas' },
];

---

<header class="hero grain" id="inicio">
  <div class="hero-top">
    <a class="hero-mark" href="#inicio">Nathan Augusto</a>
    <nav class="hero-nav" aria-label="Seções">
      {nav.map((item) => <a class="link" href={item.href}>{item.label}</a>)}
    </nav>
    <ThemeToggle class="hero-theme" />
  </div>

  <div class="hero-text">
    <h1 class="hero-title">
      <span class="mask-line"><span data-line style="--i:0">Sua ideia é</span></span>
      <span class="mask-line"><span data-line style="--i:1">o ponto de partida.</span></span>
    </h1>
    <p class="lead hero-lead" data-load style="--d:420ms">
      Sou o Nathan Augusto, tatuador de preto e cinza, realismo animal e coberturas. O projeto nasce da conversa, da
      anatomia e da intenção por trás da tatuagem.
    </p>
    <div class="hero-actions" data-load style="--d:500ms">
      <a class="button" href="#jornadas" data-magnetic>Ver projetos</a>
      <a class="link" href="#orcamento">Solicitar orçamento</a>
    </div>
  </div>

  <div class="hero-frame">
    {/* Respingos de tinta saindo por trás dos cantos do retrato, longe do rosto. */}
    <InkSplat seed={41} color="accent" class="hero-splat hero-splat--a" />
    <InkSplat seed={17} color="stencil" class="hero-splat hero-splat--b" />
  <figure class="hero-media" data-open>
    <Picture
      src={nathan}
      formats={['avif', 'webp']}
      widths={[480, 720]}
      sizes="(max-width: 820px) 100vw, 44vw"
      alt="Nathan Augusto de perfil no estúdio, sob a luz do ring light"
      loading="eager"
      fetchpriority="high"
      class="hero-photo"
    />
  </figure>
    <Picture src={logo} formats={['webp']} widths={[120, 240]} sizes="120px" alt="" loading="eager" class="hero-seal" />
  </div>
</header>

<!-- Celular: barra inferior com o menu e o orçamento ao alcance do polegar. -->
<div class="float-bar" data-float-cta>
  <button type="button" class="float-menu" data-menu-open aria-controls="menu-celular" aria-expanded="false">Menu</button>
  <a class="button float-cta" href="#orcamento">
    Solicitar orçamento
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18 6M8 6h10v10" fill="none" stroke="currentColor" stroke-width="2.5" /></svg>
  </a>
</div>

<div class="menu-sheet on-ink" id="menu-celular" data-menu hidden>
  <button type="button" class="menu-close link" data-menu-close>Fechar</button>
  <nav aria-label="Seções">
    <ul role="list">
      {nav.map((item) => <li><a href={item.href} data-menu-link>{item.label}</a></li>)}
      <li><a href="#orcamento" data-menu-link>Orçamento</a></li>
    </ul>
  </nav>
  <ThemeToggle />
</div>

<div class="site-bar" data-site-bar>
  <a class="site-bar-mark" href="#inicio">Nathan Augusto</a>
  <nav class="site-bar-links" aria-label="Seções">
    {nav.map((item) => <a class="link" href={item.href}>{item.label}</a>)}
  </nav>
  <ThemeToggle />
  <a class="button site-bar-cta" href="#orcamento">Solicitar orçamento</a>
</div>

<style>
  .hero {
    --top: 76px;
    --photo-h: min(calc(100svh - var(--top) - 2 * var(--margin)), 980px);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto 1fr;
    column-gap: clamp(32px, 5vw, 96px);
    min-height: 100svh;
    max-height: 1100px;
    background: var(--bg);
    overflow: clip;
    isolation: isolate;
  }

  .hero-top {
    grid-column: 1 / -1;
    grid-row: 1;
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 18px var(--margin);
  }
  .hero-mark { font-weight: 800; font-stretch: 150%; text-transform: uppercase; text-decoration: none; font-size: var(--step-body); white-space: nowrap; }
  .hero-nav { display: flex; flex-wrap: wrap; gap: 6px 24px; margin-left: auto; font-size: var(--step-body); font-weight: 600; }

  .hero-text {
    grid-column: 1;
    grid-row: 2;
    align-self: center;
    display: grid;
    gap: 28px;
    padding: 0 0 var(--margin) var(--margin);
  }
  .hero-title {
    font-size: clamp(2.75rem, 4.6vw, 5.25rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
    font-weight: 800;
  }
  .hero-lead { max-width: 34ch; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; }

  /* Retrato vertical na proporção da foto: a cabeça inteira, sem ampliar além do original. */
  .hero-frame {
    grid-column: 2;
    grid-row: 2;
    position: relative;
    align-self: start;
    margin: 0 var(--margin) var(--margin) 0;
    isolation: isolate;
  }
  .hero-frame :global(.hero-splat) { z-index: -1; }
  .hero-frame :global(.hero-splat--a) { width: clamp(130px, 12vw, 200px); height: auto; top: -4%; left: -9%; }
  .hero-frame :global(.hero-splat--b) { width: clamp(150px, 13vw, 220px); height: auto; bottom: 2%; left: -11%; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero-frame :global(.hero-splat) { animation: splat-in 700ms var(--ease-expo) both; }
    :global(.js) .hero-frame :global(.hero-splat--a) { animation-delay: 650ms; }
    :global(.js) .hero-frame :global(.hero-splat--b) { animation-delay: 780ms; }
  }
  @keyframes splat-in { from { opacity: 0; transform: scale(0.3) rotate(-20deg); } }
  .hero-media {
    position: relative;
    margin: 0;
    height: var(--photo-h);
    aspect-ratio: 4 / 5;
    max-width: 52vw;
    background: var(--bg-2);
  }
  .hero-media :global(.hero-photo) { width: 100%; height: 100%; object-fit: cover; object-position: 40% 30%; }
  /* Selo com a logo dele no canto do retrato. */
  .hero-frame :global(.hero-seal) {
    position: absolute;
    left: clamp(-56px, -3vw, -24px);
    bottom: clamp(24px, 4vw, 56px);
    width: clamp(88px, 8vw, 128px);
    height: auto;
    padding: 10px;
    background: var(--color-ink);
    border-radius: 50%;
  }

  /* Barra fixa do desktop: aparece ao rolar para cima depois da abertura. */
  .site-bar { display: none; }
  :global(.js) .site-bar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 8px var(--margin);
    background: var(--bg);
    color: var(--fg);
    transform: translateY(-110%);
    transition: transform var(--t-ui) var(--ease-out);
  }
  :global(.js) .site-bar.is-on,
  :global(.js) .site-bar:focus-within { transform: none; }
  .site-bar-mark { font-weight: 800; font-stretch: 150%; text-transform: uppercase; text-decoration: none; font-size: var(--step-small); white-space: nowrap; }
  .site-bar-links { display: flex; gap: 22px; margin-left: auto; font-size: var(--step-small); }
  .site-bar-cta { min-height: 40px; font-size: var(--step-small); white-space: nowrap; }

  .float-bar { display: none; }
  .menu-sheet {
    position: fixed;
    inset: 0;
    z-index: 70;
    display: grid;
    align-content: center;
    gap: 40px;
    padding: 72px var(--margin) 40px;
  }
  .menu-sheet[hidden] { display: none; }
  .menu-sheet ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .menu-sheet a { font-size: clamp(2rem, 9vw, 3rem); font-weight: 800; text-decoration: none; line-height: 1.2; }
  .menu-close { position: absolute; top: 20px; right: var(--margin); background: none; border: 0; color: inherit; font: inherit; font-weight: 600; padding: 10px; cursor: pointer; }

  @keyframes nudge { 50% { transform: translate(4px, -4px); } }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      min-height: 0;
      max-height: none;
      padding-bottom: 48px;
    }
    .hero-top { padding: 14px var(--margin); }
    .hero-nav { display: none; }
    :global(.hero-theme) { margin-left: auto; padding: 0 12px; }
    /* No topo do celular fica só o ícone; o nome continua para leitores de tela. */
    .hero-top :global(.theme-label) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .hero-frame { grid-column: 1; grid-row: 2; margin: 0 var(--margin); }
    .hero-frame :global(.hero-splat) { display: none; }
    .hero-media { height: 50svh; aspect-ratio: auto; max-width: none; }
    .hero-frame :global(.hero-seal) { left: 12px; bottom: 12px; width: 76px; padding: 8px; }
    .hero-text { grid-column: 1; grid-row: 3; padding: 28px var(--margin) 0; gap: 20px; }
    .hero-title { font-size: clamp(2rem, 8.6vw, 2.75rem); }

    :global(.js) .site-bar { display: none; }
    :global(.js) .float-bar {
      position: fixed;
      left: var(--margin);
      right: var(--margin);
      bottom: calc(14px + env(safe-area-inset-bottom));
      z-index: 50;
      display: flex;
      gap: 8px;
      transform: translateY(160%);
      transition: transform 520ms var(--ease-expo);
    }
    :global(.js) .float-bar.is-on { transform: none; }
    .float-menu {
      min-height: 58px;
      padding: 0 18px;
      border: 0;
      background: var(--color-ink);
      color: var(--color-paper);
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }
    .float-cta { flex: 1; justify-content: space-between; min-height: 58px; font-size: 1.0625rem; }
    .float-cta svg { width: 24px; height: 24px; }
    @media (prefers-reduced-motion: no-preference) {
      /* Ao aparecer, a seta dá dois toques para indicar que leva a algum lugar. */
      :global(.js) .float-bar.is-on .float-cta svg { animation: nudge 700ms var(--ease-out) 520ms 2; }
    }
  }
</style>

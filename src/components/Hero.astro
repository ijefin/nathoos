---
import { asset } from '../lib/url';

const nav = [
  { href: '#processo', label: 'Processo' },
  { href: '#trabalhos', label: 'Trabalhos' },
  { href: '#sobre', label: 'Sobre' },
  { href: '#duvidas', label: 'Dúvidas' },
];
---

<header class="hero grain" id="inicio">
  <nav class="hero-nav" aria-label="Seções">
    {nav.map((item) => <a class="link" href={item.href}>{item.label}</a>)}
  </nav>

  <h1 class="hero-name display">
    <span class="mask-line"><span data-line style="--i:0">Nathan</span></span>
    <span class="mask-line"><span data-line style="--i:1">Augusto</span></span>
  </h1>

  <figure class="hero-media" data-open>
    <video
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster={asset('media/tinta.jpg')}
      width="478"
      height="850"
      aria-label="Gota de tinta preta caindo no batoque, em câmera lenta"
      data-autoplay
    >
      <source src={asset('media/tinta.webm')} type="video/webm" />
      <source src={asset('media/tinta.mp4')} type="video/mp4" />
    </video>
  </figure>

  <div class="hero-copy">
    <p class="lead" data-load style="--d:420ms">
      Tatuagem em preto e cinza, blackwork e coberturas. Sua ideia é o ponto de partida: o projeto nasce da
      conversa, da anatomia e da intenção por trás dela.
    </p>
    <div class="hero-actions" data-load style="--d:500ms">
      <a class="button" href="#orcamento" data-magnetic>Solicitar orçamento</a>
      <a class="link" href="#processo">Conheça meu processo</a>
    </div>
  </div>
</header>

<a class="button float-cta" href="#orcamento" data-float-cta>
  Solicitar orçamento
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18 6M8 6h10v10" fill="none" stroke="currentColor" stroke-width="2.5" /></svg>
</a>

<div class="site-bar" data-site-bar>
  <a class="site-bar-mark" href="#inicio">Nathan Augusto</a>
  <nav class="site-bar-links" aria-label="Seções">
    {nav.map((item) => <a class="link" href={item.href}>{item.label}</a>)}
  </nav>
  <a class="button site-bar-cta" href="#orcamento"><span class="only-wide">Solicitar orçamento</span><span class="only-narrow">Orçamento</span></a>
</div>

<style>
  /* O nome é um bloco só, com o texto logo abaixo; o vídeo da tinta ocupa a coluna da direita inteira. */
  .hero {
    --media: calc(5 * var(--col) + 4 * var(--gutter) + var(--margin));
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--media);
    grid-template-rows: auto 1fr auto auto 1fr;
    grid-template-areas:
      'nav  media'
      '.    media'
      'name media'
      'copy media'
      '.    media';
    column-gap: var(--gutter);
    height: 100svh;
    min-height: 640px;
    max-height: 1100px;
    background: var(--color-paper);
    overflow: clip;
    isolation: isolate;
  }

  .hero-nav {
    grid-area: nav;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    padding: 24px var(--margin) 0;
    font-size: var(--step-lead);
    font-weight: 600;
  }

  .hero-name {
    grid-area: name;
    margin: 0;
    padding-left: var(--margin);
    font-size: clamp(56px, 7.4vw, 128px);
  }

  .hero-copy {
    grid-area: copy;
    display: grid;
    gap: 28px;
    max-width: 34ch;
    margin-top: clamp(28px, 3vw, 48px);
    padding-left: var(--margin);
  }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; }

  .hero-media {
    grid-area: media;
    margin: 0;
    background: #0d0d0d;
    overflow: clip;
  }
  .hero-media video { width: 100%; height: 100%; object-fit: cover; object-position: 50% 62%; }

  .site-bar {
    display: none;
  }
  :global(.js) .site-bar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 10px var(--margin);
    background: var(--color-paper);
    color: var(--color-ink);
    transform: translateY(-110%);
    transition: transform var(--t-ui) var(--ease-out);
  }
  :global(.js) .site-bar.is-on,
  :global(.js) .site-bar:focus-within { transform: none; }
  @keyframes nudge { 50% { transform: translate(4px, -4px); } }

  .site-bar-mark { font-weight: 800; font-stretch: 150%; text-transform: uppercase; text-decoration: none; font-size: var(--step-small); white-space: nowrap; }
  .site-bar-links { display: flex; gap: 22px; margin-left: auto; font-size: var(--step-small); }
  .site-bar-cta { min-height: 40px; font-size: var(--step-small); white-space: nowrap; }
  .only-narrow { display: none; }

  .float-cta { display: none; }

  @media (max-width: 820px) {
    /* No celular o botão flutuante substitui a barra do topo. */
    :global(.js) .site-bar { display: none; }
    :global(.js) .float-cta {
      position: fixed;
      left: var(--margin);
      right: var(--margin);
      bottom: calc(14px + env(safe-area-inset-bottom));
      z-index: 50;
      display: flex;
      justify-content: space-between;
      min-height: 58px;
      font-size: 1.125rem;
      transform: translateY(160%);
      transition: transform 520ms var(--ease-expo);
    }
    :global(.js) .float-cta.is-on { transform: none; }
    .float-cta svg { width: 24px; height: 24px; }
    @media (prefers-reduced-motion: no-preference) {
      /* Ao aparecer, a seta dá dois toques para indicar que leva a algum lugar. */
      :global(.js) .float-cta.is-on svg { animation: nudge 700ms var(--ease-out) 520ms 2; }
    }

    .hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      grid-template-areas: 'name' 'media' 'copy';
      height: auto;
      min-height: 0;
      max-height: none;
      padding-bottom: 48px;
    }
    .hero-name { font-size: 13vw; padding: 20px var(--margin) 20px; }
    .hero-media { height: 56svh; }
    .hero-copy { max-width: none; margin-top: 24px; padding-right: var(--margin); gap: 20px; }
    .hero-copy .lead { font-size: 1.1875rem; }
    .hero-nav { display: none; }
    .site-bar-links { display: none; }
    .site-bar-cta { margin-left: auto; }
    .only-wide { display: none; }
    .only-narrow { display: inline; }
  }
</style>

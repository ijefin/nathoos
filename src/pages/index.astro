---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Specialties from '../components/Specialties.astro';
import Process from '../components/Process.astro';
import Work from '../components/Work.astro';
import Quote from '../components/Quote.astro';
import About from '../components/About.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Nathan Augusto, tatuador | Preto e cinza, blackwork e coberturas"
  description="Tatuagem em preto e cinza, blackwork e coberturas. Conte sua ideia, veja como funciona o processo e monte seu pedido de orçamento direto para o WhatsApp."
>
  <Hero />
  <main>
    <Specialties />
    <Process />
    <Work />
    <Quote />
    <About />
    <Faq />
  </main>
  <Footer />
  <script>
    import '../scripts/main';
  </script>
</Base>
